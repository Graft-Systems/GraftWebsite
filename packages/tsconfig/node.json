{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "Extends base for Node-only packages (no DOM, no JSX).",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
