{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "Extends base for Next.js apps (apps/web). Adds DOM lib, JSX, Next.js plugin.",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "plugins": [{ "name": "next" }]
  }
}
