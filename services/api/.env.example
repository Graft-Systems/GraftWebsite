# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` — it contains secrets.

# ── Django core ──
# Generate a new SECRET_KEY for each environment:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-generate-a-new-one

# True for local dev, False in production.
DJANGO_DEBUG=True

# Comma-separated. Include localhost for dev, your domain(s) for prod.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Only needed if you accept POST from a different origin (production).
# Must include https:// prefix.
CSRF_TRUSTED_ORIGINS=

# ── Clerk (Spray / DRF JWT) ──
# Required for authenticated Spray API requests. From Clerk Dashboard →
# Configure → API Keys: use the Frontend API host (e.g. happy-panda-12.clerk.accounts.dev),
# not a URL with path — or set CLERK_JWKS_URL to the full JWKS URL.
# Prefer putting these in this file (`services/api/.env`). For local dev only,
# you may also set them in `apps/web/.env.local` (Django loads that after `.env`
# without overriding keys already set here).
CLERK_FRONTEND_API=
# Optional explicit JWKS URL (overrides derivation from CLERK_FRONTEND_API).
# CLERK_JWKS_URL=https://<your-frontend-api-host>/.well-known/jwks.json
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Local dev without a Clerk→Django webhook tunnel: create User from JWT on first API call.
# Requires `email` in the session JWT (Clerk Dashboard → Configure → Sessions → Customize session token).
# CLERK_JIT_USER_PROVISIONING=true

# ── CORS ──
# Comma-separated list of origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional comma-separated regexes for preview domains.
# Example for Vercel previews: https://.*\.vercel\.app
CORS_ALLOWED_ORIGIN_REGEXES=

# ── Database ──
# Leave unset for SQLite in dev. Set to a Postgres URL in prod.
# Render can provide this automatically when you attach a Postgres database.
# Example: postgres://user:pass@host:5432/dbname
# DATABASE_URL=

# ── Email via Resend ──
RESEND_API_KEY=re_your_key_here
CONTACT_TO_EMAIL=graftsystems@gmail.com
CONTACT_FROM_EMAIL=Graft Systems Site <onboarding@resend.dev>

# ── Prod-only (optional) ──
# Force HTTPS redirect. Default True in prod. Disable only if deploying
# behind a proxy that already terminates TLS for you.
# DJANGO_SECURE_SSL_REDIRECT=True

# ── Prediction Tool (ML inference) ──
# Root path to the imported PredictionTool folder.
# See PredictionTool/HANDOFF.md for full machine-setup expectations.
PREDICTION_TOOL_ROOT=PredictionTool

# Dataset + labels used by /api/estimate when training from scratch.
# (Skipped if PREDICTION_MODEL_PATH points at a pre-trained .joblib.)
# Use absolute paths if files live outside the repo.
PREDICTION_TRAIN_DIR=PredictionTool/data/master_dataset
PREDICTION_TRAIN_CSV=PredictionTool/data/master_dataset/grapesnet_train.csv
PREDICTION_GT_CSV=PredictionTool/data/master_dataset/grapesnet_train.csv

# Optional pre-trained model; leave blank to train from dataset.
PREDICTION_MODEL_PATH=

# Where inference artifacts/metrics are written.
PREDICTION_RUNS_DIR=PredictionTool/backend/runs

# Runtime knobs.
PREDICTION_RANDOM_STATE=42
PREDICTION_VAL_FRACTION=0.2
# Master dataset has no .raw depth files (only colorized PNG visualizations),
# so leave this False locally. The original hand-features pipeline still works
# without raw depth.
PREDICTION_USE_RAW_DEPTH=false

# ── Inference backbone selector ──
# "hand"           = original v1 path: hand-engineered RGB/depth features + RandomForest
# "dinov2_vits14"  = v2 path: DINOv2 ViT-S/14 frozen backbone + HistGradientBoosting
# Default is "hand" for backwards compat. Switch to v2 with the two lines below.
PREDICTION_BACKBONE=hand

# ── How to deploy the v2 (DINOv2) model ──
# 1. Install torch + torchvision (+700MB):
#      pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu
# 2. Set:
#      PREDICTION_BACKBONE=dinov2_vits14
#      PREDICTION_MODEL_PATH=PredictionTool/data/processed/improved_v2/model.joblib
# 3. Restart Django. First /api/estimate request downloads ~85MB DINOv2 weights to
#    ~/.cache/torch/hub (cached after that). Per-image inference ~ 650ms on CPU.
# Rollback: clear PREDICTION_BACKBONE and PREDICTION_MODEL_PATH, restart.

# ── Spray integration credentials (Fernet) ──
# Required when DJANGO_DEBUG=False (e.g. staging/prod). Optional in local dev
# when DJANGO_DEBUG=True — Django derives a throwaway key from DJANGO_SECRET_KEY.
# Generate a dedicated key for production:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SPRAY_INTEGRATION_FERNET_KEY=

# Davis WeatherLink v2 (paste-key integration). Optional overrides:
# DAVIS_API_BASE=https://api.weatherlink.com/v2
# DAVIS_DEMO_MODE=true   # append demo=true + public demo station UUID for testing

# Local dev without Celery: compute today's verdict inside the API process when
# you POST …/verdicts/recompute (do NOT enable in production).
# SPRAY_VERDICT_RECOMPUTE_SYNC=true

# Suggested production values when deployed on Render + Vercel:
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=<your-render-service>.onrender.com
# CSRF_TRUSTED_ORIGINS=https://<your-vercel-domain>.vercel.app,https://<your-custom-domain>
# CORS_ALLOWED_ORIGINS=https://<your-vercel-domain>.vercel.app,https://<your-custom-domain>
