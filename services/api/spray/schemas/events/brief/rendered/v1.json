{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "brief.rendered.v1",
  "title": "brief.rendered",
  "description": "Emitted on every daily-brief render. Captures which renderer served (LLM vs deterministic-template), why the LLM path was skipped if it was, and token + latency telemetry for cost forecasting. Brief content is NOT in the payload — only metadata. Spec §13B.3.",
  "type": "object",
  "required": [
    "org_id",
    "block_id",
    "verdict_id",
    "renderer",
    "generated_at"
  ],
  "properties": {
    "org_id": { "type": "string", "format": "uuid" },
    "block_id": { "type": "string", "format": "uuid" },
    "verdict_id": { "type": "string", "format": "uuid" },
    "renderer": {
      "type": "string",
      "description": "Either 'deterministic_template@<version>' or 'llm@<model>/<prompt_version>'.",
      "minLength": 1,
      "maxLength": 200
    },
    "fallback_reason": {
      "type": ["string", "null"],
      "enum": [
        null,
        "llm_disabled",
        "llm_unavailable",
        "llm_timeout",
        "schema_mismatch",
        "hallucination_guard_failed",
        "citation_missing",
        "prose_too_long"
      ]
    },
    "prompt_tokens": { "type": "integer", "minimum": 0 },
    "completion_tokens": { "type": "integer", "minimum": 0 },
    "model": { "type": "string", "maxLength": 200 },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
