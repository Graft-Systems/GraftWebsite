{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "risk_record.emitted.v1",
  "title": "risk_record.emitted",
  "description": "Per-block, per-day, per-pathogen risk score from a single mechanistic model runner. See spec §11A.1.",
  "type": "object",
  "required": [
    "model_id",
    "model_version",
    "block_id",
    "valid_from",
    "valid_to",
    "pathogen",
    "severity_1_10",
    "raw_score",
    "thresholds_fired",
    "input_snapshot_id",
    "confidence",
    "citation_id"
  ],
  "properties": {
    "model_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "model_version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "block_id": { "type": "string", "format": "uuid" },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_to": { "type": "string", "format": "date-time" },
    "pathogen": { "type": "string", "enum": ["powdery", "downy"] },
    "severity_1_10": { "type": "number", "minimum": 1.0, "maximum": 10.0 },
    "raw_score": { "type": "object" },
    "thresholds_fired": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "citation_id"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "citation_id": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "input_snapshot_id": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "citation_id": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
