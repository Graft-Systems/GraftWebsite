{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "capture.uploaded.v1",
  "title": "capture.uploaded",
  "description": "Emitted when the finalize endpoint confirms a Capture's S3 object exists.",
  "type": "object",
  "required": ["capture_id", "block_id", "kind", "s3_key", "size_bytes", "mime_type"],
  "properties": {
    "capture_id": { "type": "string", "format": "uuid" },
    "block_id": { "type": "string", "format": "uuid" },
    "kind": { "type": "string", "enum": ["photo", "video"] },
    "s3_key": { "type": "string", "minLength": 1, "maxLength": 400 },
    "size_bytes": { "type": "integer", "minimum": 1 },
    "mime_type": { "type": "string", "minLength": 1, "maxLength": 80 },
    "taken_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
