{
  "name": "graft-systems-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Graft Systems monorepo: marketing site, Graft Spray (M0+), iOS app (M2+), and supporting services.",
  "homepage": "https://graftsystems.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Graft-Systems/GraftWebsite.git"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.0.6",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.3.3",
    "turbo": "^2.9.12"
  }
}
