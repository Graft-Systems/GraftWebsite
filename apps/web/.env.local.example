# Copy to .env.local for local dev.
# This frontend only requires these two vars.
# BACKEND_URL is used by Next.js server rewrites.
# NEXT_PUBLIC_BACKEND_URL is used directly by browser uploads/history on /tool.
# On Vercel, set both to your Render backend URL, e.g.:
# BACKEND_URL=https://graftwebsite.onrender.com
# NEXT_PUBLIC_BACKEND_URL=https://graftwebsite.onrender.com

BACKEND_URL=http://127.0.0.1:8080
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8080
