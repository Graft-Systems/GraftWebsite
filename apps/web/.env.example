# URL of the Django backend for /api/* rewrites.
# Local dev: http://127.0.0.1:8080. Prod: the Render service URL.
BACKEND_URL=http://127.0.0.1:8080

# Clerk (M0-02). Get values from the Clerk dashboard:
#   https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Backend JWT verification (Django) needs the Frontend API hostname or JWKS URL.
# Use the same value as in Clerk → API Keys (Frontend API), e.g.:
#   CLERK_FRONTEND_API=happy-panda-12.clerk.accounts.dev
# Or set CLERK_JWKS_URL to the full https://…/.well-known/jwks.json URL.
# Prefer duplicating into services/api/.env for production; locally, this file
# is also read by Django after services/api/.env (see graft_api/settings.py).
CLERK_FRONTEND_API=

# Optional Clerk routing overrides. Defaults match our /sign-in and /sign-up
# routes; uncomment only if Clerk's dashboard URLs are customised.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Internal: show raw JSON from GET /api/spray/admin/provider-health on Integrations (default off).
# NEXT_PUBLIC_SHOW_PROVIDER_HEALTH=true

# Admin CRM (/admin) — comma-separated emails allowed past CRM_ADMIN_EMAILS gate
# CRM_ADMIN_EMAILS=you@example.com

# Optional integrations for admin CRM settings
# RESEND_API_KEY=
# EMAIL_FROM=Graft CRM <crm@yourdomain.com>
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# CRON_SECRET=
# WISPR_WEBHOOK_SECRET=
